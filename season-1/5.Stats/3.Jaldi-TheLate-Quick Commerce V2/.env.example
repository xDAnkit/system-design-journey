PORT=ADD_YOUR_PORT_HERE
MONGO_URI=mongodb://127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019/instagram
# auto = detect standalone/replica/sharded (dev/test). production must set replica or sharded
MONGO_MODE=auto
REDIS_URL=ADD_YOUR_REDIS_URL_HERE
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=insta-stats
LOG_LEVEL=info
NODE_ENV=development
ENABLE_ZSTD=false
COMPRESSION_LEVEL=1
JWT_ACCESS_SECRET=ADD_YOUR_SECRET_KEY_HERE
JWT_REFRESH_SECRET=ADD_YOUR_REFRESH_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=Add_YOUR_ACCESS_EXPIRES_IN_HERE
JWT_REFRESH_EXPIRES_IN=Add_YOUR_REFRESH_EXPIRES_IN_HERE
MONGO_CIRCUIT_MS=2000
MONGO_CIRCUIT_FAILS=3
MONGO_SELECT_TIMEOUT_MS=10000
