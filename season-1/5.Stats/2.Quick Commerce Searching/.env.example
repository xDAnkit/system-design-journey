PORT=5003
NODE_ENV=development
LOG_LEVEL=info
# empty in dev = "dev-admin-key"; production needs 8+ characters
ADMIN_KEY=

# brew MongoDB, standalone, its own database
MONGO_URI=mongodb://127.0.0.1:27017/blinkit
# auto = detect standalone/replica/sharded (dev/test). production must set replica or sharded
MONGO_MODE=auto
MONGO_CIRCUIT_MS=2000
MONGO_CIRCUIT_FAILS=3
MONGO_SELECT_TIMEOUT_MS=10000

REDIS_URL=redis://127.0.0.1:6379

# infra/kafka/compose.yaml
KAFKA_BROKERS=127.0.0.1:9094
KAFKA_CLIENT_ID=qc-search
KAFKA_TOPIC_PREFIX=

# infra/typesense/compose.yaml
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=qc-local-typesense-key
TYPESENSE_COLLECTION_PREFIX=

# AI: ollama | openai | anthropic | gemini
AI_LLM_PROVIDER=ollama
AI_LLM_MODEL=gemma3:4b
AI_LLM_FALLBACK=
AI_LLM_FALLBACK_MODEL=
# embeddings: ollama | openai | gemini. A change needs pnpm reindex
AI_EMBED_PROVIDER=ollama
AI_EMBED_MODEL=bge-m3
AI_EMBED_DIMS=
AI_TIMEOUT_MS=30000

OLLAMA_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# search
SEARCH_REWRITE=true
RATE_LIMIT_SEARCH_PER_MIN=120
RATE_LIMIT_EVENTS_PER_MIN=300

# AI suggested tags go live after this much real traffic
SUGGEST_MIN_CLICKS=3
SUGGEST_MIN_SESSIONS=3
SUGGEST_MIN_CTR=0.2
