PORT=5003
NODE_ENV=test
LOG_LEVEL=warn

# MongoDB: brew mongod (standalone), own test database. Dev data in "blinkit" is never touched.
MONGO_URI=mongodb://127.0.0.1:27017/blinkit-test
MONGO_MODE=auto
MONGO_CIRCUIT_MS=2000
MONGO_CIRCUIT_FAILS=3
MONGO_SELECT_TIMEOUT_MS=10000

# Redis DB 1, so test counters and caches stay away from dev (DB 0)
REDIS_URL=redis://127.0.0.1:6379/1

# Same qc-kafka broker as dev. Test topics and consumer groups get a "test." prefix (from Phase 2 on).
KAFKA_BROKERS=127.0.0.1:9094
KAFKA_CLIENT_ID=qc-search-test
KAFKA_TOPIC_PREFIX=test.

ENABLE_ZSTD=true
COMPRESSION_LEVEL=1

# Old Insta login. Removed in Phase 1, the app still needs these until then.
JWT_ACCESS_SECRET=042b146d8f2484019e850a6da01d0b8461d4b485cf97cf2121ec8182100da119
JWT_REFRESH_SECRET=efac2fefb1b6ae186f670e24c09029c611fc0c2205f2418ec009764c2ca15407
JWT_ACCESS_EXPIRES_IN=6h
JWT_REFRESH_EXPIRES_IN=7d

# ---- Used from Phase 1 on ----

# Same Typesense server as dev, test collections get a "test_" prefix
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=qc-local-typesense-key
TYPESENSE_COLLECTION_PREFIX=test_

AI_LLM_PROVIDER=ollama
AI_LLM_MODEL=gemma3:4b
AI_LLM_FALLBACK=
AI_EMBED_PROVIDER=ollama
AI_EMBED_MODEL=bge-m3
AI_TIMEOUT_MS=30000

OLLAMA_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

ADMIN_KEY=test-admin-key-local
